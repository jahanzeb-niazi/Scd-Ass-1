            "title": "Detail",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "retry_after_s": {
            "title": "Retry After S",
            "type": "integer"
          }
        },
        "required": [
          "detail",
          "retry_after_s"
        ],
        "title": "RateLimitErrorOut",
        "type": "object"
      },
      "ReadinessOut": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "failed": {
            "items": {
              "type": "string"
            },
            "title": "Failed",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks",
          "failed"
        ],
        "title": "ReadinessOut",
        "type": "object"
      },
      "StatsOut": {
        "properties": {
          "by_category": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Category"
            },
            "title": "By Category",
            "type": "object"
          },
          "by_priority": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Priority"
            },
            "title": "By Priority",
            "type": "object"
          },
          "by_status": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Status"
            },
            "title": "By Status",
            "type": "object"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "by_category",
          "by_priority",
          "by_status"
        ],
        "title": "StatsOut",
        "type": "object"
      },
      "Status": {
        "enum": [
          "open",
          "in_progress",
          "resolved",
          "rejected"
        ],
        "title": "Status",
        "type": "string"
      },
      "StatusUpdate": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "required": [
          "status"
        ],
        "title": "StatusUpdate",
        "type": "object"
      },
      "TransitionErrorOut": {
        "properties": {
          "allowed": {
            "items": {
              "$ref": "#/components/schemas/Status"
            },
            "title": "Allowed",
            "type": "array"
          },
          "attempted": {
            "$ref": "#/components/schemas/Status"
          },
          "current": {
            "$ref": "#/components/schemas/Status"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
