          },
          "cache_hit": {
            "title": "Cache Hit",
            "type": "boolean"
          },
          "complaint_id": {
            "title": "Complaint Id",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "fallback": {
            "title": "Fallback",
