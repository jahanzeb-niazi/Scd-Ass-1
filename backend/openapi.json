            },
            "title": "Recent",
            "type": "array"
          },
          "timeout_s": {
            "title": "Timeout S",
            "type": "number"
          }
        },
        "required": [
          "active",
          "configured",
          "fallback",
          "model",
          "timeout_s",
          "cache",
          "recent"
        ],
        "title": "ProvidersOut",
        "type": "object"
      },
      "RateLimitErrorOut": {
        "properties": {
