# CivicPulse environment template.
#   cp .env.example .env      (.env is gitignored; THIS file is committed)
# Every value here is a placeholder. No real credential ever belongs in this file.

# --- PostgreSQL (Compose passes these to both database and backend) ---
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=civicpulse

# --- Triage ---
# llm | ollama | rules | simulated
TRIAGE_PROVIDER=llm
# Google AI Studio key (https://aistudio.google.com/apikey). Leave EMPTY to run
# without an LLM: every complaint is then triaged by rules:fallback — nothing breaks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
TRIAGE_TIMEOUT_S=10
# Used with: docker compose --profile ollama up -d  and  TRIAGE_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:1b
# CI only: none | error | timeout | rate_limit | malformed | bad_request
SIMULATED_FAILURE_MODE=none
SIMULATED_FAILURE_RATE=0

# --- Rate limiting (POST /api/complaints, per client IP, shared in Redis) ---
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_S=60

# --- Service ---
LOG_LEVEL=INFO

# --- Observability profile (docker compose --profile observability up -d) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- compose.prod.yaml only: which immutable images to run ---
# IMAGE_REPO=ghcr.io/<github-owner>/civicpulse
# IMAGE_TAG=<full commit sha>   (never "latest")
