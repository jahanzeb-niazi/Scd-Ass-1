# Copy this file to .env and fill in real values. .env itself is gitignored —
# never commit real credentials (§5.3: -20 and mandatory rotation if you do).

POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=civicpulse

TRIAGE_PROVIDER=simulated
# TODO(you): set to "llm" once you have a real key, or "ollama" for the offline path
GROQ_API_KEY=
GEMINI_API_KEY=

# Only used by CI/CD and compose.prod.yaml
IMAGE_TAG=latest
GITHUB_REPOSITORY=yourorg/civicpulse
