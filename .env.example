# Copy to .env and fill in. .env is gitignored; this file is the committed template.
# Every value below is a placeholder — no real credential belongs in this file.

# --- PostgreSQL ---
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=civicpulse
POSTGRES_HOST=database
POSTGRES_PORT=5432
# Alternatively give the full URL (takes precedence over the parts above):
# DATABASE_URL=postgresql://civicpulse:change-me@localhost:5432/civicpulse

# --- Redis ---
REDIS_URL=redis://cache:6379/0

# --- Triage ---
# llm | ollama | rules | simulated
TRIAGE_PROVIDER=llm
# Google AI Studio key (https://aistudio.google.com). Leave empty to run without
# an LLM: every complaint is then triaged by rules:fallback — nothing breaks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
TRIAGE_TIMEOUT_S=10
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
# CI only: none | error | timeout | rate_limit | malformed | bad_request
SIMULATED_FAILURE_MODE=none
SIMULATED_FAILURE_RATE=0

# --- Caching / rate limiting ---
STATS_CACHE_TTL_S=30
TRIAGE_CACHE_TTL_S=86400
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_S=60

# --- Service ---
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=true

# --- Frontend container (nginx) ---
BACKEND_UPSTREAM=backend:8000
